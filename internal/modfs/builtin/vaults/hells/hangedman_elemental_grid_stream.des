# Source Lua: SUBST:   w = l, W = .
# Source Lua: KPROP:   l = no_cloud_gen
# Source Lua: :  elseif you.in_branch("Coc") then
# Source Lua: KMONS:   1 = ice fiend
# Source Lua: KMONS:   2 = wendigo band / nargun
