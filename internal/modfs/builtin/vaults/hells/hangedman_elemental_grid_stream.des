# Source Lua: KMONS:   7 = simulacrum
# Source Lua: SUBST:   l = w, W = .
# Source Lua: :  else
# Source Lua: KMONS:   1 = shard shrike
# Source Lua: KMONS:   2 = seven-headed hydra simulacrum / eight-headed hydra simulacrum
# Source Lua: KMONS:   3 = orb of fire / hellephant w:5
# Source Lua: KMONS:   4 = draconian scorcher
# Source Lua: KMONS:   5 = red draconian ; cloak . mace ego:freezing ident:type
# Source Lua: KMONS:   6 = white draconian ; cloak . mace ego:flaming ident:type
# Source Lua: KFEAT:   1 = w
# Source Lua: KFEAT:   3 = l
# Source Lua: NSUBST:  0 = 1:5 / 1:6
# Source Lua: SUBST:   x : x:9 b:1, 7 = .
# Source Lua: :  end
SHUFFLE: {` / `}
