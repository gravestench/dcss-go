# Source: crawl-ref/source/dat/des/portals/bailey.des (bailey_axe_4)
# Authored Bailey geometry and content remain in this source map.
# Named Lua hooks replace the source executable sites at their stage.
NAME:    bailey_axe_4
ORIENT:  encompass
TAGS:    bailey_axe no_rotate no_item_gen no_monster_gen no_pool_fixup
#
ITEM:    any good_item
ITEM:    potion of flight ident:type
ITEM:    ring of flight ident:type
ITEM:    pair of boots ego:flying ident:type
SUBST:   e : eeef, g:eg
NSUBST:  f = 1:f / *:e
SHUFFLE: EB / XY / XY / XY
SUBST:   X = c, Y = +
NSUBST:  E = 1:+ / *:c
SUBST:   B = c
SHUFFLE: CD / XY / XY / XY
SUBST:   X = c, Y = +
NSUBST:  C = 1:+ / *:c
SUBST:   D = c
#
KFEAT:   ^ = alarm trap
SUBST:   W = w:2 .:1 W:1
SUBST:   ? = c.
SUBST:   N = nc
SUBST:   H = W.
SUBST:   ~ = W
# the following KMONS duplicates monster 1 from kobold_axe_returning
KFEAT:   ( = exit_bailey
KMONS:   ( = generate_awake kobold ; boomerang ident:type q:2 | \
                                     boomerang ident:type q:1
#
: vault.run("shared.kobold_axe_returning")
: vault.run("shared.easy_axe_fighter")
: vault.run("shared.hard_axe_fighter")
SUBST:   1 = 1., ^ = ^^.
NSUBST:  2 = 1:3 / *=223.
#
: vault.run("shared.setup")
