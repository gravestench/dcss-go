SHUFFLE: yzD / JKL / JKL
SUBST:   y = @, zD= ., JK = t, L = p
# 33% chance for an additional opening at the north east.
SHUFFLE: EFH / JKL / JKL
SUBST:   E = @, FH= ., JK = t, L = p
SUBST:   a = tt..., q = pp..., p = tttu, s = rr..., r = tu
: vault.run("remains.hellmonk_lair_end_abyssal_woods")
