# Hangedman lair caniforms friends is an authored Lair:5 ending.
# Source: crawl-ref/source/dat/des/branches/lair.des.
NAME: hangedman_lair_caniforms_friends
PLACE:   Lair:$
TAGS:    no_monster_gen no_rotate patrolling
ORIENT:  southwest
MONS:    wolf, warg, hell hound, raiju
MONS:    black bear, polar bear
KMONS:   P = plant
# The one big reward and the several smaller stacks of items
# are randomly split between the mostly-dog and mostly-bear sections.
KITEM:   % = any, any w:1
KITEM:   *| = gold, gold, gold, any good_item
NSUBST:  2 = 2:22334 / *:3
SHUFFLE: %'*" / %'"|
SUBST:   X = xx., z = xx`, ' = ., " = x, p = PP.
SUBST:   H = 3:3 4:1, 0 = 2
CLEAR:   `
# The source helper makes this a paired small ending.
TAGS: lair_end_small
WEIGHT: 5
: vault.post_place("small_end.pair")
