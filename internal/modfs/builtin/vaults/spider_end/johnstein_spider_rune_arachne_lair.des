# Pinned DCSS source: crawl-ref/source/dat/des/branches/spider.des
# Three source themes change terrain and guardians around Arachne.
NAME:   johnstein_spider_rune_arachne_lair
TAGS:   no_monster_gen
KMONS:  j = emperor scorpion / spark wasp w:5 / jorogumo
KMONS:  m = moth of wrath / ghost moth w:40 / sun moth
KMONS:  o = orb spider w:40 / demonic crawler
KMONS:  s = torpor snail / entropy weaver
ORIENT: float
PLACE:  Spider:$
# '"-_!?^
# ABCDEFG
#pick 1 of 3 different flavors
# Source conditional directives run here through a named Lua handler.
: vault.run("choose_theme")

NSUBST: 3 = 4:j / 1:s / *=2.
NSUBST: 2 = 6=o. / 2:m / 6=2. / *=1

KITEM:  O = gossamer rune of Zot
NSUBST: O = 1:O / *=%

#thin out monsters and set up loot
NSUBST: % = 2:d / 2:e / 2:f / *=def...
SUBST: 1 = 1..

KFEAT: Y = web / floor w:40
# The source shared loot helper runs at this position.
: vault.run("shared.loot")
