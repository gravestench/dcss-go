# mu_enter_wizlab_4: original Wizard Lab source map.
# MAP geometry is preserved from crawl-ref/source/dat/des/portals/wizlab.des.
# Source Lua stays in comments beside named port hooks until DES-local Lua is supported.
NAME:   mu_enter_wizlab_4
# The source shared helper supplied these selection facts.
# Vaults receives its separate single special-room chance.
DEPTH: Depths, Elf, Crypt, Vaults, !Vaults:$
TAGS: uniq_wizlab vaults_wizlab no_item_gen no_monster_gen chance_wizlab
CHANCE: 500, 0 (Vaults)
TAGS:   vaults_orient_s
KFEAT:  ! = floor
COLOUR: ! = magenta
FTILE:  !O = floor_rough_magenta
# Source Lua at hook site 1:
# :       wizlab_portal(_G, false)
: vault.run("shared.portal")
MAP
    xxxxx
    w!!!x
   ww!O!x
  www!!!x
 www..www
www..www
ww..www
w..www
@.www
@www
ENDMAP
