# minmay_crypt_entry_simple_sparse is a Vaults-side Crypt gate selected from
# the Vaults entrance pool; its float MAP fixes the approach.
# The source directives keep keyed terrain such as enter_crypt with this map.
NAME:   minmay_crypt_entry_simple_sparse
TAGS:   transparent
ORIENT: float
TAGS: crypt_entry vaults_entry_crypt
KMONS: 0 = place:Crypt:1
KFEAT: O = enter_crypt
MAP
...........
.x...x...x.
...........
...x.0.x...
...........
.x.0.O.0.x.
...........
...x.0.x...
...........
.x...x...x.
...........
ENDMAP
