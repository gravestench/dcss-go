TAGS: crypt_entry vaults_entry_crypt
KMONS: 0 = place:Crypt:1
KFEAT: O = enter_crypt
MAP
...........
.G.ccccc.G.
...c...c...
.ccc.A.ccc.
.c.......c.
.+...O...c.
.c.......c.
.ccc.B.ccc.
...c...c...
.G.ccccc.G.
