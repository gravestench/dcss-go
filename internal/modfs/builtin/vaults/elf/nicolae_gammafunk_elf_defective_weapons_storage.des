NAME:  nicolae_gammafunk_elf_defective_weapons_storage
TAGS:  transparent no_monster_gen
DEPTH: Elf
KITEM: 123 = % w:20 / scroll of enchant weapon ident:type w:5 \
       / scroll of brand weapon ident:type w:5
: vault.run("choose_weapons")
