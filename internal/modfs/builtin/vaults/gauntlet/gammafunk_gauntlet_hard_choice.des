DEPTH: Gauntlet
ORIENT: encompass
TAGS:   no_item_gen no_monster_gen no_trap_gen
# Source Lua: : gauntlet_setup(_G, "DFJLNP", "EHKMOQ")
# Separate hooks let the first two arenas resolve before the source coin flip.
: vault.run("gammafunk_gauntlet_hard_choice.opening")
: vault.run("gammafunk_gauntlet_hard_choice.finish")
# 50% chance to make the second fight harder.
