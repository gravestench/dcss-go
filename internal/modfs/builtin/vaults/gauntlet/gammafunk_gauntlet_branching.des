# gammafunk_gauntlet_branching: authored Gauntlet gauntlet map.
# MAP geometry is preserved from the pinned DCSS gauntlet.des.
# TODO: consolidate named Lua hooks into this DES when supported.
NAME:   gammafunk_gauntlet_branching
DEPTH: Gauntlet
ORIENT: encompass
TAGS:   no_item_gen no_monster_gen no_trap_gen
# Source Lua: : gauntlet_setup(_G, "DFJLNPRp", "EHKMOQSq")
# Separate hooks let the first two arenas resolve before the source coin flip.
: vault.run("gammafunk_gauntlet_branching.opening")
: vault.run("gammafunk_gauntlet_branching.finish")
# Just in case we ever add lava felids, prevent their revival in closets.
KPROP:    lG = no_tele_into
