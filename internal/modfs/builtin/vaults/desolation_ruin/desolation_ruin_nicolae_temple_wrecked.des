SUBST: V = V%., G = G., C = cc., X = x., c = c:50 x
# Source Lua: : desolation_ruins_setup(_G)
: vault.run("shared.setup")
MAP
cccCCCccccC.
c%..c%%cX...
c.G.2%%X.G..
x...c%%c...C
X.V.cccC.V.C
x...%cC%...c
c.V1%C%%1V.c
c...%cc%...c
C.V.cccC.V.c
C....X2....c
C........%Xc
ccccc..ccccc
ENDMAP
