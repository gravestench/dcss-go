# desolation_ruin_nicolae_crumbling_obelisks: original Desolation of Salt source map.
# MAP geometry is preserved from crawl-ref/source/dat/des/portals/desolation.des.
# TODO: consolidate named Lua hooks into this DES when DES-local Lua is supported.
NAME: desolation_ruin_nicolae_crumbling_obelisks
TAGS: desolation_ruin transparent
SHUFFLE: HIJK/LMNO, MO
NSUBST: q = 2:2 / *:1
SUBST: HMN = c, IJKLO = ., c = c:50 x .:5, C = c:70 .
# Source Lua: : desolation_ruins_setup(_G)
: vault.run("shared.setup")
MAP
KK.HHJJHH.KK
KJIHHJJHHIJK
.II......II.
HH.q%%%%q.HH
HH.%CCCC%.HH
JJ.%CxxC%.JJ
JJ.%CxxC%.JJ
HH.%CCCC%.HH
HH.q%%%%q.HH
.II......II.
KJIHHJJHHIJK
KK.HHJJHH.KK
ENDMAP
