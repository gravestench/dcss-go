# desolation_ruin_nicolae_vault_intact: original Desolation of Salt source map.
# MAP geometry is preserved from crawl-ref/source/dat/des/portals/desolation.des.
# TODO: consolidate named Lua hooks into this DES when DES-local Lua is supported.
NAME: desolation_ruin_nicolae_vault_intact
TAGS: desolation_ruin transparent uniq_salt_special
WEIGHT: 1
NSUBST: % = 4:% / 4:| / 1:%| / 4:$ / 2:b / 2:g / *:s
KMONS: 1b = saltling band
KMONS: 2 = imperial myrmidon / halazid warlock / crystal guardian
KMONS: g = crystal guardian
KMONS: C = ironbound convoker
KITEM: $ = gold good_item
KITEM: gsb = gold q:1 / gold q:2 / gold q:3 / gold q:4 / gold q:5
KITEM: % = any weapon good_item / any armour good_item / \
           any jewellery randart w:5 / randbook w:5
KFEAT: m = iron_grate
MAP
ccccG..Gcccc
cG........Gc
c...1..1...c
c..GmmmmG..c
c...2..2...c
cG........Gc
ccmcc..ccmcc
c%%%c..c%%%c
c%%%c..c%%%c
c%%%....%%%c
c%%%..C.%%%c
cccccccccccc
ENDMAP
