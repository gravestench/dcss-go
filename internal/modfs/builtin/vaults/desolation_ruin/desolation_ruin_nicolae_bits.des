# desolation_ruin_nicolae_bits: original Desolation of Salt source map.
# MAP geometry is preserved from crawl-ref/source/dat/des/portals/desolation.des.
# TODO: consolidate named Lua hooks into this DES when DES-local Lua is supported.
NAME: desolation_ruin_nicolae_bits
TAGS: desolation_ruin transparent
NSUBST: % = 7:% / 2:1 / 2:2 / 2=x. / 2=G. / *:., X = 3:x / 3:. / *:X
SUBST: X = x..., c = c:50 x .:5
# Source Lua: : desolation_ruins_setup(_G)
: vault.run("shared.setup")
MAP
............
.ccXcc.ccXcc
.c%.%c.c%X%c
.XX...X....X
.c%.ccXcc.%c
.cc.c%.%cXcc
.XXX..X..X..
.cc.c%.%c.cc
.c%Xcc.cc.%c
..XX..X.XX.X
.c%.%c.c%.%c
.cc.cc.cc.cc
ENDMAP
