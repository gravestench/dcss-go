# minmay_elemental_castle keeps its authored Zot geometry and source selectors.
# Named Lua hooks below perform only the source decisions that
# cannot remain static DES directives.
# Source: crawl-ref/source/dat/des/branches/zot.des.
NAME:    minmay_elemental_castle
ORIENT:  southwest
DEPTH:   Zot, !Zot:$
TAGS:    no_rotate
: vault.run("choose_element")
# Source Lua: : if crawl.coinflip() then
# Source Lua: MONS:    titan, storm dragon, electric golem
# Source Lua: SUBST:   F = 3
# Source Lua: ITEM:    lightning rod, book of lightning, staff of air, book of storms
# Source Lua: : elseif crawl.coinflip() then
# Source Lua: MONS:    frost giant, ice dragon
# Source Lua: KMONS:   F = shard shrike
# Source Lua: MARKER:  F = lua:fog_machine { cloud_type = "freezing vapour", \
# Source Lua:               pow_min = 5, pow_max = 15, delay = 10, size = 2, \
# Source Lua:               walk_dist = 0, spread_rate= 0 }
# Source Lua: # XXX: we should replace iceblast with something else when it's not
# Source Lua: # in this game's chosen item set.
# Source Lua: ITEM:    wand of iceblast, staff of cold, book of winter, \
# Source Lua:          ozocubu's autobiography
# Source Lua: SUBST:   w = l
# Source Lua: SUBST:   W = l..
# Source Lua: : else
# Source Lua: MONS:    fire giant, fire dragon
# Source Lua: KMONS:   F = balrug
# Source Lua: MARKER:  F = lua:fog_machine { cloud_type = "flame", pow_min = 5, \
# Source Lua:               pow_max = 15, delay = 10, size = 2, walk_dist = 0, \
# Source Lua:               spread_rate= 0 }
# Source Lua: ITEM:    book of the dragon, staff of fire, book of fire, book of annihilations
# Source Lua: : end
SUBST:   1 = 112.
SUBST:   2 = 221.
SHUFFLE: defg
