# st_large_dragon_hoard_4 keeps its authored Zot geometry and source selectors.
# Named Lua hooks below perform only the source decisions that
# cannot remain static DES directives.
# Source: crawl-ref/source/dat/des/branches/zot.des.
NAME:   st_large_dragon_hoard_4
DEPTH: Zot, !Zot:$
TAGS: no_item_gen
SUBST:  D = DDD$
KITEM:  D = $
KMONS:  1 = nonbase draconian band
: vault.run("shared.dragon_hoard_setup")
