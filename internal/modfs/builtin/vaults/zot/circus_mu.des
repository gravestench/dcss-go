# circus_mu keeps its authored Zot geometry and source selectors.
# Named Lua hooks below perform only the source decisions that
# cannot remain static DES directives.
# Source: crawl-ref/source/dat/des/branches/zot.des.
NAME:   circus_mu
DEPTH:  Zot, !Zot:$
ORIENT: float
TAGS:   no_rotate no_hmirror no_monster_gen
MONS:   killer klown
MONS:   elephant / w:5 dire elephant / w:2 hellephant
MONS:   human ; club
SUBST:  1 = 1 2:5 3:20
SUBST:  2 = 2 2 .
SUBST:  % = !:10 .:20
KITEM:  ! = club / nothing
COLOUR: " : yellow
