# ebering_klown_carousel keeps its authored Zot geometry and source selectors.
# Named Lua hooks below perform only the source decisions that
# cannot remain static DES directives.
# Source: crawl-ref/source/dat/des/branches/zot.des.
NAME:    ebering_klown_carousel
DEPTH:   Zot, !Zot:$
ORIENT:  float
TAGS:    no_monster_gen no_trap_gen
MONS:    killer klown, ancient lich / dread lich, death cob
NSUBST:  - = 2 / 3 = 3.. / *:.
: vault.run("choose_entry_side")
# Source Lua: : if (crawl.coinflip()) then
# Source Lua: NSUBST:  > = 1 = }:80 > / 1 = ):80 > / 1 = ]:80 >
# Source Lua: SUBST:   1 = 1 0:30 .
# Source Lua: : else
# Source Lua: NSUBST:  G = 3={[( / *:G
# Source Lua: NSUBST:  1 = 6 = 1. / *=0...
# Source Lua: NSUBST:  > = >. / *:.
# Source Lua: : end
NSUBST:  ^ = 4:^ / *=^..
SUBST:   a = aaax.
KFEAT:   a = iron_grate
KFEAT:   ^ = dispersal trap
: vault.run("shared.coloured_glass")
