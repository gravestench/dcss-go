# nicolae_zot_crop_circle keeps its authored Zot geometry and source selectors.
# Named Lua hooks below perform only the source decisions that
# cannot remain static DES directives.
# Source: crawl-ref/source/dat/des/branches/zot.des.
NAME: nicolae_zot_crop_circle
DEPTH: Zot, !Zot:1
TAGS: no_monster_gen transparent
SHUFFLE: {[(
NSUBST: p = 2:2 / 1:12 / 1
MONS: plant, death cob
MAP
   ..@..
  .......
 ...ppp...
...p...p...
..p.....p..
@.p..{..p.@
..p.....p..
...p...p...
 ...ppp...
  .......
   ..@..
ENDMAP
