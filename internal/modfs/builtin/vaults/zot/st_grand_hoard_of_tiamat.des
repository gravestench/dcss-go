# st_grand_hoard_of_tiamat keeps its authored Zot geometry and source selectors.
# Named Lua hooks below perform only the source decisions that
# cannot remain static DES directives.
# Source: crawl-ref/source/dat/des/branches/zot.des.
NAME:   st_grand_hoard_of_tiamat
DEPTH: Zot, !Zot:$
TAGS: no_item_gen
TAGS:   no_monster_gen
KMONS:  1 = patrolling Tiamat, patrolling golden dragon
SUBST:  D = DDD$
KITEM:  D = $
KITEM:  $ = gold q:1
: vault.run("shared.dragon_hoard_setup")
