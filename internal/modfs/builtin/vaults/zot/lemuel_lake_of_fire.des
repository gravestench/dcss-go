# lemuel_lake_of_fire keeps its authored Zot geometry and source selectors.
# Named Lua hooks below perform only the source decisions that
# cannot remain static DES directives.
# Source: crawl-ref/source/dat/des/branches/zot.des.
NAME:  lemuel_lake_of_fire
DEPTH: Zot
SUBST: * =*l
KMONS: * = orb of fire
KFEAT: * = l
SUBST: .=.l
MAP
 ..ll..
..llll..
.llllll.
.ll**ll.
.ll**ll.
.llllll.
..llll..
 ..ll..
ENDMAP
