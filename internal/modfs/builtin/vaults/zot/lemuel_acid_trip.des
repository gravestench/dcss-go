# lemuel_acid_trip keeps its authored Zot geometry and source selectors.
# Named Lua hooks below perform only the source decisions that
# cannot remain static DES directives.
# Source: crawl-ref/source/dat/des/branches/zot.des.
NAME:   lemuel_acid_trip
DEPTH:  Zot, !Zot:$
ORIENT: centre
MONS:   oklob plant, acid blob, jelly, yellow draconian
