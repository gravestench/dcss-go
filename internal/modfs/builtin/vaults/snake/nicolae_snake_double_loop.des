# Nicolae snake double loop is a source Snake vault.
# The extra tag allows another ordinary Snake map after this one fits.
# Source default-depth: Snake is made explicit for this separate file.
NAME: nicolae_snake_double_loop
DEPTH: Snake
TAGS:    transparent extra
SHUFFLE: AB, CD
SUBST:   AC = ., BD = +
MAP
 xxxxxxx    xxxxxxx
xx.....xxxxxx.....xx
x.......xxxx.......x
@...x...xxxx...x...x
@..xxx..xxxx..xxx..x
xxxxxxBBxxxxCCxxx..x
xx...A..A..D..D....x
x....A..A..D..D...xx
x...xxBBxxxxCCxxxxxx
x..xxx..xxxx..xxx..@
x...x...xxxx...x...@
x.......xxxx.......x
xx.....xxxxxx.....xx
 xxxxxxx    xxxxxxx
ENDMAP
