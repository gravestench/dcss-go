# This minimal gate balances the Swamp entry draw; its fog marker is the authored hazard.
# The keyed O feature becomes the saved reciprocal branch stair.
# Source definition: crawl-ref/source/dat/des/branches/swamp.des
NAME:   swamp_mist
TAGS:   swamp_entry transparent
KFEAT:  O = enter_swamp
MARKER: O = lua:fog_machine { \
             pow_min = 8, pow_max = 12, delay = 25, \
             size = 2, walk_dist = 1, spread_rate= 33 }
MAP
O
ENDMAP
