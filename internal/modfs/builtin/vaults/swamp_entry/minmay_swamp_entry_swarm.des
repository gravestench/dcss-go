# The mosquito swarm and flooded center guard the keyed descent.
# The keyed O feature becomes the saved reciprocal branch stair.
# Source definition: crawl-ref/source/dat/des/branches/swamp.des
NAME:   minmay_swamp_entry_swarm
TAGS:   swamp_entry
WEIGHT: 5
SUBST:  W = 1WWWWW, t = ttt., T = tttW, W = WWWwww., ' = W
