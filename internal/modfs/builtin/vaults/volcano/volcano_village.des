NAME:       volcano_village
DEPTH: Volcano
TAGS:       no_item_gen no_monster_gen
ORIENT:     encompass
WEIGHT:     20
SUBST:      p = lw, W = wW`, q = ll`, r = lx
SHUFFLE:    JK / LM / NO
NSUBST:     J = 4=. / $def
NSUBST:     L = 3=1 / 12. / 2=2 / 3=$def / .
NSUBST:     N = 2=1 / 12. / 1=2 / 1=$def / .
SUBST:      K = ^, MO = ., . = .:99 ^:1
KPROP:      ` = no_tele_into
# Source Lua: :           fiery_guardians(_G, true, true)
: vault.run("shared.guardians_village")
# Source Lua: :           volcano_setup(_G)
: vault.run("shared.setup")
# Source Lua: :           place_chained_volcano(_G)
: vault.run("shared.fog_chained")
