NAME:   volcano_aerie
DEPTH: Volcano
TAGS:   no_item_gen no_monster_gen
ORIENT: encompass
WEIGHT: 20
MONS:   lindwurm, efreet
MONS:   molten gargoyle / earth elemental w:8 / toenail golem w:2
MONS:   fire elemental / fire vortex w:8
KFEAT:  K = l
NSUBST: R = 2:1 / * = ll'
NSUBST: Y = 2:2 / 1:24 / 7:4 / 6:J / *:.
