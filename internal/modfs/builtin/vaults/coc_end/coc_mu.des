# Source: crawl-ref/source/dat/des/branches/coc.des.
# Cocytus seventh-floor controller; MAP rows match source bytes.
NAME:    coc_mu
ORIENT:  encompass
MONS:    patrolling Antaeus, ice fiend
MONS:    nargun, azure jelly, simulacrum, wendigo, freezing wraith
KMONS:   8 = ice statue
KMONS:   9 = frost giant
KMONS:   0 = titan
KMONS:   e = water elemental
KMONS:   E = elemental wellspring
KFEAT:   eE = w
SUBST:   3 = 3:5 4:4 5:4 6:2 7:2 9:1
NSUBST:  0 = 5:0 / *:3
# Source serpent_of_hell_setup: unique, persistent Hell-branch selection.
: vault.run("shared.serpent_of_hell")
SUBST:   ^ : ^^^W. , ^ = W.
SUBST:   X : XXXc. , X = c.
SUBST:   " = 8:1 .:10
SUBST:   ' = .cc
SUBST:   ; : ;;;;w , ; = wc
KFEAT:   # = permarock_wall
COLOUR:  # = lightcyan
NSUBST:  - = 1:+ / *:c
# Source coc_setup: place and rotation metadata must exist before selection.
PLACE: Coc:$
TAGS: no_rotate
: vault.run("shared.coc_setup")
MAP
