# Source: crawl-ref/source/dat/des/branches/coc.des.
# Cocytus seventh-floor controller; MAP rows match source bytes.
NAME:    coc_grunt
ORIENT:  encompass
MONS:    patrolling Antaeus, ice fiend, shard shrike / nothing
KMONS:   8 = ice statue
KMONS:   9 = elemental wellspring
KMONS:   de = ice fiend
KMONS:   fg = titan
KITEM:   df = superb_item
KITEM:   egh = gold
# Source serpent_of_hell_setup: unique, persistent Hell-branch selection.
: vault.run("shared.serpent_of_hell")
KFEAT:   D = floor
KFEAT:   X = open_sea
KFEAT:   9 = w
# Preserve this source border-fill call at its authored operation site.
: vault.run("shared.open_sea_border")
SHUFFLE: 1O|d$e / 5!*f%g, |d / $e
NSUBST:  H = 1:D / *:8
SUBST:   * = |, % = $, 5 = 2
# Preserve this source border-fill call at its authored operation site.
: vault.run("shared.open_sea_border")
# Source coc_setup: place and rotation metadata must exist before selection.
PLACE: Coc:$
TAGS: no_rotate
: vault.run("shared.coc_setup")
