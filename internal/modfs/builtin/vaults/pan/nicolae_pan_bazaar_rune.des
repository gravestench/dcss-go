# nicolae_pan_bazaar_rune is a Pandemonium map from pinned DCSS.
# MAP rows and ordinary DES declarations remain source-authoritative.
# Source: crawl-ref/source/dat/des/branches/pan.des.
NAME:    nicolae_pan_bazaar_rune
DEPTH: Pan
TAGS:    patrolling transparent no_item_gen
WEIGHT:  5
ORIENT:  float
# Source Lua: {{
# Source Lua:   local shoplord = string.gsub(crawl.make_name(), " ", "_")
# Source Lua:   local shops = { "Zone", "Stash", "Warehouse", "Hoard", "Trove", "Cache",
# Source Lua:                   "Depot", "Stock", "Depository", "Bin", "Store", "Supply",
# Source Lua:                   "Sales", "Hole", "Deals", "Outlet", "Market", "Inventory" }
# Source Lua:   local shopsuffix = shops[ crawl.random2(#shops) + 1 ]
# Source Lua:   kmons("Z = pandemonium lord name:" .. shoplord)
# Source Lua:   if you.have_rune("demonic") or is_validating() then
# Source Lua:     kfeat("Z = general shop name:" .. shoplord .. " type:Rarities suffix:"
# Source Lua:                .. shopsuffix .. " ; any weapon randart | any armour randart | "
# Source Lua:                .. "any jewellery randart | any randbook")
# Source Lua:   else
# Source Lua:     kfeat("Z = general shop name:" .. shoplord .. " type:Demonic_Rune suffix:"
# Source Lua:                .. shopsuffix .. " count:1 ; demonic rune of Zot")
# Source Lua:   end
# Source Lua:   kfeat("H = general shop name:" .. shoplord .. " type:Assorted" ..
# Source Lua:         " suffix:Sundries ; any | any good_item | star_item")
# Source Lua:   kfeat("J = scroll shop name:" .. shoplord .. " type:Exquisite" ..
# Source Lua:         " suffix:Manuscripts ; " .. string.gsub(dgn.good_scrolls, "/", "|"))
# Source Lua:   kfeat("K = distillery shop name:" .. shoplord .. " type:Quality" ..
# Source Lua:         " suffix:Elixirs ; " .. string.gsub(dgn.loot_potions, "/", "|"))
# Source Lua:   kfeat("L = general shop name:" .. shoplord .. " type:Fine" ..
# Source Lua:         " suffix:Accessories ; any misc | any wand w:15")
# Source Lua:   kfeat("M = jewellery shop name:" .. shoplord)
# Source Lua:   kfeat("N = book shop name:" .. shoplord)
# Source Lua:   kfeat("O = general shop name:" .. shoplord .. " type:Superb" ..
# Source Lua:         " suffix:Hardware ; any weapon good_item | any armour good_item")
# Source Lua:   kfeat("S = general shop name:" .. shoplord .. " type:Infernal " ..
# Source Lua:         "suffix:Boutique ; any weapon good_item ego:draining | " ..
# Source Lua:         "any weapon good_item ego:pain | any weapon good_item ego:chaos | " ..
# Source Lua:         "any weapon good_item ego:vampirism | demon blade good_item | " ..
# Source Lua:         "demon trident good_item | demon whip good_item | " ..
# Source Lua:         "staff of death w:3 | scroll of torment q:2 w:5 | " ..
# Source Lua:         "scroll of torment q:3 w:5 | randbook disc:necromancy")
# Source Lua: }}
: vault.run("configure")
# 2/3 chance of nothing, 4/15 chance of gold, 1/15 chance of a lot of gold
KITEM:   HJKLMNOS-_ = $ w:4 / $ good_item w:1 / nothing w:10
# Fountains just get a 1/6 chance of a regular stack of gold
KITEM:   TUY = $ / nothing w:50
# Monsters in the outer promenade area: 1/9 chance of a guest, 1/9 chance of
# a greater demon, 2/9 chance of any demon or demonspawn, 5/9 chance of nothing.
# Guests are demon summoning monsters from other branches, who are here to
# commune with demons, make deals, or just browse the pandemonic bazaar.
KMONS:   HJKLMNOS-_ = deep elf demonologist / kobold demonologist / \
           mummy priest / orc high priest / orc sorcerer / dread lich / \
           greater demon w:60 / demonspawn warmonger w:2 / \
           demonspawn black sun w:2 / demonspawn blood saint w:2 / \
           demonspawn corrupter w:2 / any demon w:112 / nothing w:300
KMONS:   YPQR = greater demon w:360 / demonspawn black sun / \
           demonspawn blood saint / demonspawn corrupter / demonspawn warmonger
KFEAT:   _ = altar_gozag
KFEAT:   P = exit_pandemonium
KFEAT:   QR = transit_pandemonium
KFEAT:   Y = Y
SHUFFLE: Pp/Qq/Rr, S_, TU
SUBST:   p = +, qr = c
NSUBST:  D = + / x, E = + / x, F = + / x
NSUBST:  S = H / J / K
SHUFFLE: HJKLMNOS
FTILE:   HJKLMNOPQRSTUYZcx-+_. = floor_limestone
# This vault has a special announcement to provide a heads-up that this rune
# is not obtained in the usual way. It uses yellow text to evoke Gozag's gold
# related messages, as well the messages from arriving in the four unique
# lords' levels.
# Source Lua: epilogue {{
# Source Lua: if not you.have_rune("demonic") then
# Source Lua:     crawl.mpr("A powerful Pandemonium lord resides here.", "warning")
# Source Lua:     crawl.mpr("<yellow>It is willing to " ..
# Source Lua:               "make a deal for the demonic rune of Zot.</yellow>")
# Source Lua: end
# Source Lua: }}
: vault.run("epilogue")
MAP
        xxDxx
       xx...xx
       D.....D
      xx.....xx
  xxDxx...U...xxDxx
 xx...---...---...xx
 x....-_-...-S-....x
xx....---...---....xx
x...T...ccccc...T...x
xx.....cc...cc.....xx
 F.....r..P..q.....E
 xx---ccY...Ycc---xx
  x-S-c...Z...c-_-x
 xx---ccQ...Rcc---xx
 F.....c..Y..c.....E
xx.....cc...cc.....xx
x...U...ccpcc...U...x
xx....---...---....xx
 F....-_-...-S-....E
 xx...---...---...xx
  xxFxx...T...xxExx
      xx.....xx
       F.....E
       xx...xx
        xxxxx
ENDMAP

#############################################################################
# Pandemonium lesser demon vaults: (announced) rune serial vaults
#############################################################################

# Place (two) big, fancy demonic rune vaults, (with an announced guarantee of
# the demonic rune's presence) in some fixed thematic threats and a few
# essentially-decorative small vaults.
# FIXME:
#  * dgn.place_maps can't guarantee the double-up vault placement for
#    these relatively large floating vaults (and die_on_error, aside
#    from being insufficient, shows player-visible error messages) -
#    some validator check is needed for the concept to work.
