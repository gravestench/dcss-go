# nicolae_desolation_temple: original Desolation of Salt source map.
# MAP geometry is preserved from crawl-ref/source/dat/des/portals/desolation.des.
# TODO: consolidate named Lua hooks into this DES when DES-local Lua is supported.
NAME:    nicolae_desolation_temple
DEPTH: Desolation
TAGS:    no_dump no_monster_gen patrolling
WEIGHT:  5
ORIENT:  encompass
KITEM:   %O = any weapon good_item / any armour good_item / randbook w:5 / \
              any jewellery randart w:5 / gold good_item w:1
KMONS:   1 = saltling band
KMONS:   O2 = imperial myrmidon / halazid warlock / crystal guardian
KMONS:   p = withered plant perm_ench:petrified
KFEAT:   ! = iron_grate
KFEAT:   < = exit_desolation
KFEAT:   H = stone_arch
KFEAT:   P = endless_salt
KFEAT:   t = petrified_tree
# Source Lua: : if crawl.coinflip() then
: vault.run("shared.temple_shuffle")
# Source conditional SHUFFLE: LMN is emitted by the hook above.
# Source conditional shuffle ends here.
NSUBST:  < = 1=< / S / -, % = 15=% / 10=| / .
SUBST:   . = .:1000 1:6, ~ = P., t = tt., p = p.., V = VV., G = GG., ! = !..
SUBST:   L = c:1 x:3 .:12, M = c:4 x:4 .:8, N = c:9 x:3 .:4, J = 1:9 2:1 .
SUBST:   ` = x..
COLOUR:  P = white
# Source Lua: : set_border_fill_type('endless_salt')
: vault.run("shared.border")
# Source Lua: : set_feature_name("granite_statue", "ruined idol")
: vault.run("shared.idol")
TILE:    G = DNGN_CRUMBLED_COLUMN
MARKER:  S = lua:fog_machine { cloud_type = "salt",  walk_dist=3, \
             pow_min=6, pow_max=20, delay=5, size=15, spread_rate=10, }
