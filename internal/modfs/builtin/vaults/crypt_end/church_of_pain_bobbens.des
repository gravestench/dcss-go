# church_of_pain_bobbens is a required Crypt:3 ending; its northwest MAP
# shapes the final floor.
# The source directives keep Lua decisions at choose_theme_roll,
# theme_monsters with this map.
NAME:   church_of_pain_bobbens
ORIENT: northwest
TAGS:   no_monster_gen no_item_gen layout_city
PLACE:  Crypt:$
# MONSTER LAYOUT
# boss (1)
# boss guard (2)
# secondary boss (3)
# support (4)
# primary guard (5)
# advanced guard (6)
# in tombs (7)

# 30% - skeletal (standard)
# 30% - vampire (pretty hardcore, with easier bosses)
# 30% - ghost
# 10% - mummy (pretty evil)

# skeletal monsters
: vault.run("choose_theme_roll")
: vault.run("theme_monsters")
NSUBST: / = 1:| / 2:* / *:%
NSUBST: %*| = 1:d / 1:h
: vault.run("bonus_loot")
MAP
