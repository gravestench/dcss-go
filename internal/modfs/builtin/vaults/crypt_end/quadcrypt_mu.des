# quadcrypt_mu is a required Crypt:3 ending; its encompass MAP shapes the
# final floor.
# The source directives keep keyed terrain such as granite_statue and Lua
# decisions at choose_vampire_or_mummy, choose_bone_or_spirit with this map.
NAME:   quadcrypt_mu
ORIENT: encompass
TAGS:   no_monster_gen no_item_gen no_pool_fixup no_rotate no_vmirror no_hmirror
PLACE:  Crypt:$
####### chapel garden
SUBST:  F = f ?
SUBST:  f = p:1 .:1
KFEAT:  p = .
KMONS:  p = withered plant
####### hidden skeleton; sometimes good pain weapon, or draining short sword
KMONS:  ! = skeletal warrior ; w:2 dagger ego:pain | short sword ego:draining |\
                               w:2 rapier ego:pain | w:1 quick blade ego:pain
KFEAT:  o = granite_statue
SUBST:  B = b %
KITEM:  b = any book
SUBST:  u = U Y
KMONS:  8 = gargoyle
####### NW monsters (chapel).
KMONS:  A = ancient lich / dread lich / w:4 mummy priest
KMONS:  DL = lich w:40 / ancient lich / dread lich
KMONS:  E = war gargoyle
KMONS:  G = shadow / wraith
####### NE monsters (hoard). On a coinflip, either vampires or mummies.
: vault.run("choose_vampire_or_mummy")
####### SE monsters (catacombs). Either corporeal or incorporeal undead.
: vault.run("choose_bone_or_spirit")
####### SW monsters (crematory). Either fiery undead or hellish.
: vault.run("choose_fire_or_hell")
####### Randomisation of doors
NSUBST: K = 1:+ / *:v
NSUBST: ' = 1:+ / *:v
NSUBST: " = 1:+ / *:v
NSUBST: *| = 1:d / 1:h
####### Tomb entrance
: vault.run("choose_tomb_gate")
SUBST:  ? = $ % * |:1
: vault.run("bonus_loot")
MAP
