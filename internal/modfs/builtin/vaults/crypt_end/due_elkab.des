# due_elkab is a required Crypt:3 ending; its north MAP shapes the final
# floor.
# The source directives keep keyed terrain such as closed_door, alarm and Lua
# decisions at choose_theme_roll, theme_monsters with this map.
NAME:   due_elkab
PLACE:  Crypt:$
ORIENT: north
TAGS:   no_monster_gen no_item_gen no_pool_fixup no_rotate no_trap_gen
TAGS:   layout_city
NSUBST: A = 1:+ / *:c
NSUBST: B = 1:+ / *:c
NSUBST: C = 1:6 / *:5
KFEAT:  YD = closed_door
KFEAT:  ER = alarm trap
KFEAT:  CSd = floor
COLOUR: YsDdE = darkgrey
: vault.run("choose_theme_roll")
: vault.run("theme_monsters")
SUBST:  '" = .
NSUBST:  %*| = 1:d / 1:h
: vault.run("bonus_loot")
MAP
                ccccccccccccccccccccccccccccccc
                ccccccccccccccccccccccccccccccc
                cc*$*c|%*.......**|c.........cc
                cc$3$c|*...'2'...%|c..G.3.G..cc
                cc...c|%|.......|%|c.........cc
                ccc+cccccc.....ccccccc+cccBBBcc
                cc...c...ccc+ccc...c.....c$$$cc
                cc.4.c.G.4.RRR.4.G.+..G..c$$$cc
