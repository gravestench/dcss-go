KITEM: - = plate armour / plate armour good_item w:1 / chain mail \
           / chain mail good_item w:1 / scale mail / scale mail good_item w:1 \
           / ring mail / ring mail good_item w:1
KITEM: " = plate armour / plate armour good_item w:1 / chain mail \
           / chain mail good_item w:1 / scale mail / scale mail good_item w:1 \
           / ring mail / ring mail good_item w:1
KFEAT: ^ = web trap
NSUBST: ` = 4:2 / 4=2., ' = 2=*% / 5=%., . = 2:^ / 4=^.
MAP
