NAME: hangedman_spider_trapstep
TAGS:   no_monster_gen no_pool_fixup patrolling allow_dup
DEPTH:  Spider:1-2, Zot, !Zot:$
KMONS:  0 = patrolling hornet
KMONS:  1 = tarantella
: vault.run("configure")
# Source Lua: : if you.in_branch("Zot") then
# Source Lua directive: KMONS:  2* = jumping spider / orb spider w:5
# Source Lua directive: KMONS:  3| = ghost moth / moth of wrath
