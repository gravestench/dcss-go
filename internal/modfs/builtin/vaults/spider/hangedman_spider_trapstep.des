# Source Lua: :   if you.depth() == dgn.br_depth("Zot") - 1 then
# Source Lua directive: KFEAT:  ~ = zot trap w:20 / web trap / . w:5
# Source Lua: :   else
# Source Lua directive: KFEAT:  ~ = zot trap w:15 / shaft trap / web trap w:5 / . w:5
# Source Lua: :   end
# Source Lua directive: NSUBST: 4 = 1:122 / 1:112
# Source Lua directive: SUBST:  X = c
# Source Lua: : else
# Source Lua directive: KMONS:  2 = tarantella
# Source Lua directive: KMONS:  3 = orb spider
# Source Lua directive: KITEM:  | = superb_item / any good_item w:5
# Source Lua directive: KFEAT:  ` = shaft trap
# Source Lua directive: KFEAT:  ^ = web w:9 / web trap w:1 / . w:6
# Source Lua directive: KFEAT:  ~ = shaft trap w:15 / web / . w:5
# Source Lua directive: NSUBST: 4 = 1:2 / *:W
# Source Lua directive: SUBST:  X = x
# Source Lua: : end
KITEM:  * = star_item / superb_item w:5
KFEAT:  123*| = shallow_water
KMASK:  . = !no_monster_gen
SUBST:  ' = ..^
