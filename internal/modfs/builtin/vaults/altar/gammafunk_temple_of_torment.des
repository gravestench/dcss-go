# Source overflow altar map; DES geometry and directives remain authoritative.
# Source Lua is preserved below for the named-hook port.
NAME:   gammafunk_temple_of_torment
DEPTH: D:3-, Depths
WEIGHT: 2
TAGS:   no_monster_gen no_trap_gen temple_overflow_2
TAGS:   temple_overflow_kikubaaqudgha temple_overflow_yredelemnul
# source: : if you.depth() <= 4 then
MONS: zombie / skeleton
MONS: mummy / shadow imp / wight / necrophage / phantom
KMONS: 3 = menkaure, necrophage / wight
SUBST: 2 = 2---
# source: : elseif you.depth() <= 7 then
MONS: zombie / skeleton / mummy / shadow imp / wight / necrophage / phantom
MONS: wraith / vampire
KMONS: 3 = menkaure, wraith / vampire
SUBST: 2 = 12--
# source: : else
MONS: mummy / wight / zombie / skeleton / phantom
MONS: wraith / vampire / shadow / w:5 death knight / w:5 skeletal warrior
MONS: flayed ghost / death knight
NSUBST: 2 = 2 / 2-
# source: : end
SUBST:  1 = 11-
NSUBST: R = R / -
KFEAT:  D = altar_kikubaaqudgha
KFEAT:  E = altar_yredelemnul
MARKER: P = lua:transp_loc("temple_of_torment_entry")
MARKER: Q = lua:transp_dest_loc("temple_of_torment_entry")
MARKER: R = lua:transp_loc("temple_of_torment_exit")
MARKER: S = lua:transp_dest_loc("temple_of_torment_exit")
TILE:   G = dngn_sarcophagus_pedestal_left
TILE:   c = wall_tomb
FTILE:  -QRVDE|*$123Gcn = floor_tomb
COLOUR: G = yellow
COLOUR: -QR|*$123 = brown
# source: : set_feature_name("granite_statue", "sarcophagus")
: vault.run("features.sarcophagus")
MAP
 ...............
 .nnnnnnnnnnnnn.
 .nR----1----Rn.
 .n-2-------2*n.
 .n--ccc-ccc-$n.
 .n--cGc-cGc-Dn.
..n----------|n..
@Pn1----Q---3YnS@
..n----------*n..
 .n--cGc-cGc-En.
 .n--ccc-ccc-$n.
 .n-2-------2|n.
 .nR----1----Rn.
 .nnnnnnnnnnnnn.
 ...............
ENDMAP

