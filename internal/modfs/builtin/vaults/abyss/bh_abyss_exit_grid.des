# bh_abyss_exit_grid retains the pinned DCSS Abyss MAP and ordinary DES directives.
# Source: crawl-ref/source/dat/des/branches/abyss.des.
NAME:  bh_abyss_exit_grid
DEPTH: Abyss
TAGS:  abyss_exit unrand allow_dup
SUBST: a = x.
SUBST: b = x..
SUBST: c = x...
# Source exit choice depends on the current Abyss branch depth.
: vault.run("shared.exit_o")
MAP
   b b b b b
  a.a.a.a.a.a
 a.x.x.x.x.x.a
b.x.x.x.x.x.x.b
 a.x.x.x.x.x.a
b.x.x.c.c.x.x.b
 a.x.c.0.c.x.a
b.x.x.c.c.x.x.b
 a.x.x.x.x.x.a
b.x.x.x.x.x.x.b
 a.x.x.x.x.x.a
  a.a.a.a.a.a
   b b b b b
ENDMAP
