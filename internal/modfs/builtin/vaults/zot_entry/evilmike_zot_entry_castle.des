# evilmike_zot_entry_castle is an authored Zot entrance from pinned DCSS.
# Its geometry and fixed directives stay in DES; any source script
# decision is called as a named Lua hook at its original position.
# Source: crawl-ref/source/dat/des/branches/zot.des.
NAME:   evilmike_zot_entry_castle
PLACE: Depths:$
ORIENT: float
TAGS:   no_monster_gen zot_entry layout_city
NSUBST: O = 1:O / *:A
SUBST:  ^ = ^..
SUBST:  s = ccc+
KFEAT:  ^ = alarm trap
FTILE:  "OADx = floor_marble
COLOUR: " = magenta
TILE:   x = wall_zot_magenta
COLOUR: x = magenta
FTILE:  .+cm^01234$ = floor_hall
SUBST:  D = +, "' = .
NSUBST: 3 = 1:9 / *:3
: vault.run("shared.entry_setup")
# Source Lua: : zot_entry_setup(_G)
MONS:   base draconian ; glaive | halberd
MAP
