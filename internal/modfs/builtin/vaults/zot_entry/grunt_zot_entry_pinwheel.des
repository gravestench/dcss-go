# grunt_zot_entry_pinwheel is an authored Zot entrance from pinned DCSS.
# Its geometry and fixed directives stay in DES; any source script
# decision is called as a named Lua hook at its original position.
# Source: crawl-ref/source/dat/des/branches/zot.des.
NAME:   grunt_zot_entry_pinwheel
PLACE: Depths:$
ORIENT: float
TAGS:   no_monster_gen zot_entry patrolling transparent
KFEAT:  A = stone_arch
COLOUR: 123c+. = magenta
FTILE:  123c+.AO = floor_hall
NSUBST: A = 1:O / *:A, 1 = 2:0 / *:1, 3 = 1:9 / *:3
: vault.run("shared.entry_setup")
# Source Lua: : zot_entry_setup(_G)
MAP
       @
     cc+cc
    cc...c
   cc...cc ccccc
   c...cc cc.1.cc
   c1.1c cc.3...cc
   c.3.ccc.2.1...c
   cc.2.cc..ccc..+@
    cc..AcAcc cc.c
 ccc ccccccccc ccc
 c.cc ccAcA..cc
@+..ccc..cc.2.cc
 c...1.2.ccc.3.c
 cc...3.cc c1.1c
  cc.1.cc cc...c
   ccccc cc...cc
         c...cc
         cc+cc
           @
ENDMAP
