      =
xxxxx...xxxxx
x-1-D.2.D-1-x
x---D...D---x
x+x+x+x+x+x+x
x.E---F---E.x
x.E-1-F-1-E.x
x2xHHHxHHHx2x
x.E-1-F-1-E.x
x.E---F---E.x
x+x+x+x+x+x+x
x---D...D---x
x-1-D.2.D-1-x
xxxxx...xxxxx
ENDMAP
