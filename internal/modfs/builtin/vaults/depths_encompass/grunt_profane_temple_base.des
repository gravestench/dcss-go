# This zero-weight base temple remains a named helper in the catalog. Its
# shared guardians and common geometry document the source template without
# entering Profane Halls' ordinary tagged child draw.
# Source: crawl-ref/source/dat/des/branches/depths_encompass.des.
NAME: grunt_profane_temple_base
TAGS: grunt_profane_temple allow_dup
WEIGHT: 0
: vault.run("shared.profane_setup")
# Source Lua: : grunt_profane_halls_setup(_G)
KFEAT: A = stone_arch
MARKER: A = lua:props_marker { portal=1 }
KMASK: 12345 = !no_monster_gen
