# Profane Halls is a whole-floor Depths ending. Its four temple requests
# choose among tagged helpers; the H chamber becomes the Zot gate only when
# the branch schedule places Zot here, otherwise it becomes a loot chamber.
# Source: crawl-ref/source/dat/des/branches/depths_encompass.des.
NAME: grunt_profane_halls
TAGS: no_monster_gen uniq_d_encompass
PLACE: Depths:$
DEPTH: Depths:2-
WEIGHT: 1 (Depths:$), 10
ORIENT: encompass
SHUFFLE: {[(<
: vault.run("zot_shape")
# Source Lua: : if you.where() == dgn.level_name(dgn.br_entrance("Zot")) then
# Source Lua: SUBST: }])> = G
# Source Lua: : else
# Source Lua: SHUFFLE: }])>
# Source Lua: : end
SUBVAULT: d : grunt_profane_temple
SUBVAULT: e : grunt_profane_temple
SUBVAULT: f : grunt_profane_temple
SUBVAULT: g : grunt_profane_temple
: vault.run("shared.profane_setup")
# Source Lua: : grunt_profane_halls_setup(_G)
: vault.run("zot_monsters")
# Source Lua: : if you.where() == dgn.level_name(dgn.br_entrance("Zot")) then
# Source Lua: NSUBST: D = 1:K / 1:L / 1:M / 1:N
# Source Lua: KMONS: K = storm dragon
# Source Lua: KMONS: L = shadow dragon
# Source Lua: KMONS: M = quicksilver dragon
# Source Lua: KMONS: N = golden dragon
# Source Lua: : else
# Source Lua: KMONS: D = 8 band
# Source Lua: : end
KMONS: 0 = 0 band w:15 / nothing
KMONS: 9 = 9 band / 0 band
KMASK: 1290KLMN = !no_monster_gen
: vault.run("zot_child")
# Source Lua: : if you.where() == dgn.level_name(dgn.br_entrance("Zot")) then
# Source Lua: SUBVAULT: H : grunt_zot_portal
# Source Lua: : else
# Source Lua: SUBVAULT: H : grunt_profane_loot
# Source Lua: : end
