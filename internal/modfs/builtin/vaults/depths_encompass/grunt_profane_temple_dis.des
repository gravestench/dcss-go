# The Dis temple contributes iron-themed terrain and monsters to Profane
# Halls. Its feature-name hook records the source iron statue name after
# the shared guardian setup and before the MAP is projected.
# Source: crawl-ref/source/dat/des/branches/depths_encompass.des.
NAME: grunt_profane_temple_dis
TAGS: grunt_profane_temple no_monster_gen
: vault.run("shared.profane_setup")
# Source Lua: : grunt_profane_halls_setup(_G)
NSUBST: 4 = 8:4 / *:., 5 = 1:6 / *:5
KMONS: 4 = iron troll / nothing
KMONS: 5 = skeletal warrior / iron troll w:1
KMONS: 6 = iron dragon / war gargoyle
KFEAT: A = stone_arch
MARKER: A = lua:props_marker { portal=1 }
COLOUR: G = cyan
TILE: G = dngn_statue_iron_golem
: vault.run("feature_name")
# Source Lua: : set_feature_name("granite_statue", "iron statue")
KMASK: 12345 = !no_monster_gen
MAP
%%.5.......5.%%
%G...........G%
.....4...4.....
....4.v.v.4....
.....v...v.....
...4...G...4...
.....v...v.....
....4.v.v.4....
.....4...4.....
...............
.G...G...G...G.
 ..5.......5..
 ....G...G....
 .............
  ...G...G...
  ...........
   ..G...G..
   ....B....
    .:%3%:.
     %2A2%
ENDMAP
