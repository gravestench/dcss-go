# Box Level fills an entire middle Depths floor with two opposing monster
# themes. The hooks choose one coherent theme and the source potion pool;
# the MAP and its many keyed rooms remain authoritative here.
# Source: crawl-ref/source/dat/des/branches/depths_encompass.des.
NAME:    box_level_dp
DEPTH: Depths:2-, !Depths:$
TAGS:    no_pool_fixup no_rotate uniq_d_encompass
ORIENT:  encompass
: vault.run("loot_potions")
# Source Lua: : kitem("g = " .. dgn.loot_potions)
KITEM:   zZ = any potion / nothing w:90
# Two themes: birds with elves, and spriggans with giants.
: vault.run("choose_theme")
# Source Lua: : if crawl.coinflip() then
# Source Lua: MONS:   tengu conjurer / tengu warrior / deep elf elementalist \
# Source Lua:         / sphinx / nothing
# Source Lua: MONS:   tengu reaver / deep elf annihilator / deep elf high priest \
# Source Lua:         / caustic shrike
# Source Lua: : else
# Source Lua: MONS:   spriggan berserker / spriggan air mage / ettin / stone giant \
# Source Lua:         / frost giant / fire giant / nothing
# Source Lua: MONS:   spriggan defender / titan / juggernaut
# Source Lua: : end
KMONS:   L = fire dragon
KMONS:   ~ = ice dragon
KMONS:   z = meliai / spark wasp w:2 / nothing w:20
KMONS:   Z = spark wasp
KFEAT:   L = l
KFEAT:   ~ = w
NSUBST:  w = ~ / w, l = L / l
NSUBST:  D = + / b, E = + / b, F = + / b, H = + / b, J = + / x, K = + / n
SUBST:   ' : ''l. , ' = l., " : ""W. , " = Ww..
SUBST:   * = * % % $ $ .
SUBST:   ; = 9 0
SUBST:   ! = %$, & = *%
COLOUR:  a = yellow
TILE:    a = wall_wax
SUBST:   a = x
MARKER:  P = lua:props_marker { portal=1 }
KFEAT:   P = stone_arch
