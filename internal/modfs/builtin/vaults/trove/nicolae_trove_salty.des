# Source: crawl-ref/source/dat/des/portals/trove.des (nicolae_trove_salty)
# Salt terrain gives this rare reward floor its identity. Its source exit
# remains usable even though this map does not call the usual shared setup hook.
NAME:       nicolae_trove_salty
DEPTH: Trove
TAGS:       no_item_gen no_monster_gen allow_dup
ORIENT:     encompass
WEIGHT:     5
KITEM:      d = acquire weapon good_item / acquire armour good_item / \
                any jewellery randart w:5 / randbook w:5
KFEAT:      E = endless_salt
MARKER:     S = lua:fog_machine { cloud_type = "salt",  walk_dist=3, \
                pow_min=6, pow_max=20, delay=5, size=15, spread_rate=10, }
NSUBST:     d = 16=d / `..
SUBST:      ` = x., c = c:90 x, d = d:4 |:3
LFLOORCOL:  lightgrey
LROCKCOL:   brown
LFLOORTILE: floor_salt
LROCKTILE:  wall_desolation
TILE:       G = DNGN_CRUMBLED_COLUMN
# Source Lua: : set_border_fill_type('endless_salt')
: vault.run("shared.endless_salt")
# Source Lua: : set_feature_name("granite_statue", "ruined idol")
: vault.run("shared.ruined_idol")
