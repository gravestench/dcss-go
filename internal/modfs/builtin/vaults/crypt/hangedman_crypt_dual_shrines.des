# hangedman_crypt_dual_shrines is a Crypt room eligible at Crypt; its source
# MAP supplies authored geometry.
# The source directives keep keyed terrain such as altar_yredelemnul,
# altar_kikubaaqudgha with this map.
NAME:    hangedman_crypt_dual_shrines
TAGS:    no_monster_gen no_item_gen patrolling
DEPTH:   Crypt
# Choose two of the following:
# Yred nearly-all-melee set, Kiku necro-casters set, ghosts set, tomb set.
