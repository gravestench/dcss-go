# cheibrodos_crypt_cold_storage is a Crypt room eligible at Crypt; its east
# MAP supplies authored geometry.
# The source directives keep kmons choice | = ancient lich / dread lich with
# this map.
NAME: cheibrodos_crypt_cold_storage
TAGS: no_item_gen no_monster_gen
DEPTH: Crypt
ORIENT: east
MONS: freezing wraith, shadow wraith
KMONS: | = ancient lich / dread lich
KITEM: | = plate armour good_item ego:cold_resistance \
           / ice dragon scales good_item \
           / crystal plate armour good_item ego:cold_resistance w:5 \
           / executioner's axe good_item ego:freezing w:5 \
           / battleaxe good_item ego:freezing \
           / lajatang good_item ego:freezing \
           / triple sword good_item ego:freezing w:5 \
           / great sword good_item ego:freezing \
           / double sword good_item ego:freezing \
           / great mace good_item ego:freezing \
           / eveningstar good_item ego:freezing \
           / bardiche good_item ego:freezing \
           / quick blade good_item  ego:freezing w:5
MARKER: V = lua:fog_machine { cloud_type = "freezing vapour", pow_min = 0, \
                              pow_max = 10, delay = 20, size = 3, \
                              walk_dist = 0, excl_rad = 0 }
NSUBST: " = 3:1 / 3=1.. / 2:2 / 2=2..
MAP
          cccccccccccc
          cccccccccccc
  ccccccc cc"""""n..cc
  cccccccccc"""""n.Vcc
.ccc...ccccc"""""n..cc
.......""""""""""ccccc
@....G.""""""""""=|ccc
.......""""""""""ccccc
.ccc...ccccc"""""n..cc
  cccccccccc"""""n.Vcc
  ccccccc cc"""""n..cc
