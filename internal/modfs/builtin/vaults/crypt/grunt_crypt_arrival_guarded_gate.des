# grunt_crypt_arrival_guarded_gate is a Crypt room eligible at Crypt:1; its
# south MAP supplies authored geometry.
# The source directives keep keyed terrain such as granite_statue and Lua
# decisions at arm_sarcophagi with this map.
NAME:   grunt_crypt_arrival_guarded_gate
TAGS:   uniq_crypt_arrival no_item_gen no_monster_gen no_trap_gen \
        layout_rooms layout_city layout_corridors no_hmirror no_rotate extra
ORIENT: south
DEPTH:  Crypt:1
WEIGHT: 30
TILE:   H = dngn_sarcophagus_pedestal_left
