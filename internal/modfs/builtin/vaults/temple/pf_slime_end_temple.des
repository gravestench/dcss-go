# Source Temple MAP; its Lua script is ported to a same-named hook.
NAME:      pf_slime_end_temple
TAGS:      temple_rare temple_altars_11
PLACE:     Temple
ORIENT:    encompass
WEIGHT:    5
NSUBST:    J = 11:B / *:J
KFEAT:     J = altar_jiyva
KFEAT:     S = slimy_wall
SUBST:     " : " .:3,  " = .c, ' : ' .:3,  ' = .S
SUBST:     - = --.
LFLOORCOL: green
COLOUR:    - = lightgray
FTILE:     .JB = floor_slime
: vault.run("configure")
