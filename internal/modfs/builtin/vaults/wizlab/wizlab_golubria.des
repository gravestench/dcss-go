: vault.run("wizlab_golubria.site_1")

# Source epilogue runs when the whole lab is placed;
# its first-visit announcement is owned by lab travel.
# epilogue{{
#             wizlab_milestone(_G, "The Roulette of Golubria")
# }}
: vault.post_place("wizlab_golubria.epilogue")
