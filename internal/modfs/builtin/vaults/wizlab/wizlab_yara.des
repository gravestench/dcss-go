# wizlab_yara: original Wizard Lab source map.
# MAP geometry is preserved from crawl-ref/source/dat/des/portals/wizlab.des.
# Source Lua stays in comments beside named port hooks until DES-local Lua is supported.
NAME:   wizlab_yara
# wizlab_setup supplies these whole-floor selection facts.
DEPTH: WizLab
ORIENT: encompass
TAGS: no_item_gen no_monster_gen
TAGS:   no_rotate
ITEM:   any book w:15 / randbook disc:hexes owner:Yara w:4 / spellbinder w:1
ITEM:   scroll of enchant armour ident:all / scroll of enchant weapon ident:all
# Source Lua at hook site 1:
# :       yara_students(_G)
: vault.run("wizlab_yara.site_1")
MONS:   mana viper, quicksilver dragon
KMONS:  P = bush
# Source Lua block at hook site 2:
# wizname = crawl.make_name()
# kmons("5 = patrolling Head Instructor dbname:Head_Instructor name:"
#       .. string.gsub(wizname, " ", "_") .. " ; triple sword ego:antimagic \
#             . triple sword ego:antimagic . plate armour ego:willpower")
: vault.run("wizlab_yara.site_2")
NSUBST: * = 4:d / 4:e / *=*., 5 = 1:5 / *:1, D = 1:2 / *=G1
NSUBST: E = 1:2 / *:1, 3 = 1:4 / * = 3", A = 1:< / *:A
SUBST:  P : Pt", F = 211111, 1 = 1...., x = xxxx., - = x
FTILE:  125.*de$G+ = floor_limestone
FTILE:  Tt"PA<34 = floor_dirt / floor_grass:15
TILE:   x = wall_brick
TILE:   c = wall_church
# Source Lua at hook site 3:
# :           set_random_mon_list(
# :               "mana viper / tengu conjurer / ogre mage / " ..
# :               "deep elf knight / wizard / naga mage / " ..
# :               "salamander mystic / necromancer / vampire mage / " ..
# :               "tengu reaver w:1 / quicksilver dragon w:1")
# :           wizlab_setup(_G)
: vault.run("wizlab_yara.site_3")
# Source epilogue runs when the whole lab is placed;
# its first-visit announcement is owned by lab travel.
# epilogue {{
#             wizlab_milestone(_G, "Yara's Duelist Academy")
# }}
: vault.post_place("wizlab_yara.epilogue")
