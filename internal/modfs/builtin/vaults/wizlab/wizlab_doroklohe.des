# wizlab_doroklohe: original Wizard Lab source map.
# MAP geometry is preserved from crawl-ref/source/dat/des/portals/wizlab.des.
# Source Lua stays in comments beside named port hooks until DES-local Lua is supported.
NAME:       wizlab_doroklohe
# wizlab_setup supplies these whole-floor selection facts.
DEPTH: WizLab
ORIENT: encompass
TAGS: no_item_gen no_monster_gen
TAGS:       no_rotate
LROCKCOL:   yellow
KFEAT:      ! = x
# Source Lua block at hook site 1:
