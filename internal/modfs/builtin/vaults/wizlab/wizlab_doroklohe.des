: vault.run("wizlab_doroklohe.site_17")
# Source epilogue runs when the whole lab is placed;
# its first-visit announcement is owned by lab travel.
# epilogue{{
#             wizlab_milestone(_G, "Doroklohe's Tomb")
# }}
: vault.post_place("wizlab_doroklohe.epilogue")
