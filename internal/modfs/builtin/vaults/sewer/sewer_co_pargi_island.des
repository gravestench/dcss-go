DEPTH: Sewer
TAGS:    no_item_gen no_monster_gen no_pool_fixup
ORIENT:  encompass
# Placing Pargi, he appears in one of three places. The water moccasin serves
# as the back-up, in case Pargi was already placed in the Dungeon.
