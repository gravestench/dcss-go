# dreamdust_gauntlet_exit_labyrinth: authored Gauntlet gauntlet_exit map.
# MAP geometry is preserved from the pinned DCSS gauntlet.des.
# TODO: consolidate named Lua hooks into this DES when supported.
NAME:   dreamdust_gauntlet_exit_labyrinth
DEPTH: Gauntlet
TAGS:   gauntlet_exit
KMONS:  < = patrolling minotaur
KFEAT:  a = b
KFEAT:  < = exit_gauntlet
# Set up openings in the inner and outer walls.
NSUBST: a = . / v
NSUBST: p = . / b
# Set up dead ends in the inner and outer sections.
NSUBST: - = c / .
NSUBST: ` = v / `
SUBST:  T : T U G
# Source Lua: : gauntlet_exit_loot(_G)
: vault.run("shared.loot")
