# co_window_paths_c is a common window piece.
# Parallel corridors thread around glass-wall dividers. This changes how the floor connects.
# Its tag and WEIGHT let the controller select it without a file list.
NAME:   co_window_paths_c
WEIGHT: 3
TAGS:   transparent allow_dup extra serial_co_window_common
SUBST:  X:xm
MAP
  x x
  x x
  x x
x@x@x@x
x.x.x.x
x.X.X.x
x.m.m.x
x.X.X.x
x.x.x.x
x@x@x@x
  x x
  x x
  x x
ENDMAP
