# co_window_2corner is a common window piece.
# Two angled glass barriers turn the traversable route. This changes how the floor connects.
# Its tag and WEIGHT let the controller select it without a file list.
NAME:   co_window_2corner
WEIGHT: 5
TAGS:   transparent allow_dup extra serial_co_window_common
MAP
xxxxxxx@xxxxx
xxxxxxx.xxxxx
xxxxxxx.xxxxx
xxxxxxx.xxxxx
xxxxxxx.xxxxx
xxxxxxm.....@
xxxxxmmmxxxxx
@.....mxxxxxx
xxxxx.xxxxxxx
xxxxx.xxxxxxx
xxxxx.xxxxxxx
xxxxx.xxxxxxx
xxxxx@xxxxxxx
ENDMAP
