# Open medium is one authored shape in the ruined-city serial.
# Its MAP geometry stays in DES; shared Lua hooks supply pillar and portal policy.
NAME: column_ruins_open_medium
TAGS:    serial_column_ruins_simple
TAGS:    allow_dup transparent
WEIGHT:  10
SUBST:   T : TG__
SUBST:   T = TTUVVV
: vault.run("column_ruins_setup.configure")
MAP
 NMMMN
NLLKLLN
MLJJJLM
MKJTJKM
MLJJJLM
NLLKLLN
 NMMMN
ENDMAP
