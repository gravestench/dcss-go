# co_window_corner_a is a small window piece.
# An angled glass barrier turns the traversable route. This changes how the floor connects.
# Its tag and WEIGHT let the controller select it without a file list.
NAME:   co_window_corner_a
WEIGHT: 5
TAGS:   transparent allow_dup extra serial_co_window_small
SUBST:  X:Xxm, X=xm
MAP
    x
    x
    x
..@.x@x
....x.x
@...X.x
....m.x
xxXmm.x
x.....x
x.xxxxx
x.x
x@x
ENDMAP
