NAME: serial_park_tiny_1
DEPTH: D
TAGS:    allow_dup transparent extra decor serial_park
KMONS:   1 = bush
FTILE:   E = floor_grass
SUBST:   E = .t1
FTILE:   D = floor_vault
MAP
  ..
 .DD.
.DEED.
.DEED.
 .DD.
  ..
ENDMAP
