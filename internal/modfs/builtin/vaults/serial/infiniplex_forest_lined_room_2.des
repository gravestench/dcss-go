# infiniplex_forest_lined_room_2 shapes a deliberate tree-lined structure in the forest family.
# D:1 and D:2 raise its selection weight; Lair has its own weight.
# Its MAP stays authored here, while the shared Lua setup chooses trees.
NAME:    infiniplex_forest_lined_room_2
TAGS:    transparent allow_dup serial_forest
DEPTH: D:1-4, Lair
WEIGHT: 6 (D:1), 4 (D:2), 2 (D:3-4), 2 (Lair)
SHUFFLE: JK
SUBST:   J = t
SUBST:   K = .
: vault.run("forest_setup.configure")
MAP
t t t t
 .....
t.J.J.t
 .....
t.J.J.t
 .....
t t t t
ENDMAP
