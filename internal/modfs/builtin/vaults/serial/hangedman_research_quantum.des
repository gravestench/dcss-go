# Displacing creatures and energy fog surround the book.
# The original MAP and local declarations stay in DES; shared
# Lua setup adds caster, substitutions, and both D items.
NAME: hangedman_research_quantum
DEPTH: Depths, Vaults:1-4, Elf:1-2
TAGS: serial_research no_monster_gen patrolling
WEIGHT: 1
MONS:   blink frog / jumping spider w:7, spatial vortex
KMONS:  D = eldritch tentacle
MARKER: D = lua:fog_machine { cloud_type = "translocational energy", \
            pow_min = 3, pow_max = 10, delay = 50, size = 1, walk_dist = 1 }
COLOUR: .012D = magenta
FTILE:  .n+012D = floor_demonic_red
: vault.run("research_setup.translocation")
MAP
@'''@'''@
abcd+dcba
b.......b
c.......c
d.0nnn0.d
a.nn2nn.a
b+n121n+b
c.11D11.c
dcbadabcd
ENDMAP
