# Summoners and purple smoke occupy this room.
# The original MAP and local declarations stay in DES; shared
# Lua setup adds caster, substitutions, and both D items.
NAME: hangedman_research_convocations
DEPTH: Depths, Vaults:1-4, Elf:1-2
TAGS: serial_research no_monster_gen patrolling
WEIGHT: 1
MONS:    boggart, worldbinder
KMONS:   D = glowing orange brain
MARKER:  ' = lua:fog_machine { cloud_type = "purple smoke", pow_min = 4, \
                pow_max = 10, delay = 40, size = 2, walk_dist = 1 }
# Note: these colours are to match the Hellbinder wizlab.
COLOUR:  .'0123D = yellow
FTILE:   .'n+0123D = floor_pebble_lightred
SHUFFLE: 12
: vault.run("research_setup.summoning")
MAP
@'''@'''@
abcd+dcba
b0.....0b
c+nnnnn+c
d...'...d
a'.1.1.'a
b..nnn..b
c2..D..2c
dcbadabcd
ENDMAP
