# serial_ice_m forms a ringed ice crossing in the serial ice pool.
# Its source MAP and substitutions stay here; the shared Lua setup chooses
# branch-specific monsters and fog at the authored hook position.
NAME:   serial_ice_m
TAGS:   allow_dup luniq vaults_empty serial_ice extra mini_float transparent
WEIGHT: 2
SUBST:  + = Ww.
SUBST:  ! = .!!
: vault.run("ice_setup.configure")
MAP
xxxx@xxxx
xww+.+wwx
xw+...+wx
x+.....+x
@...!...@
x+.....+x
xw+...+wx
xww+.+wwx
xxxx@xxxx
ENDMAP
