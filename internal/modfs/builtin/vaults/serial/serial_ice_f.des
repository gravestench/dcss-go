# serial_ice_f forms a cold water basin in the serial ice pool.
# Its source MAP and substitutions stay here; the shared Lua setup chooses
# branch-specific monsters and fog at the authored hook position.
NAME:   serial_ice_f
TAGS: serial_ice extra mini_float transparent
WEIGHT: 2
SUBST:  w = wwW, . = ...w
: vault.run("ice_setup.configure")
MAP
---------
-.......-
-..www..-
-.wwWww.-
-.wWWWw.-
-.wwWww.-
-..www..-
-.......-
---------
ENDMAP
