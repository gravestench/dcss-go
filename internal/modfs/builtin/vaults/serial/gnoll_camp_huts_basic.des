# Paired huts scatter source-assigned gnolls, leaders, and dogs across open ground.
# Source default-depth is reset here: the controller selects this map by tag only.
NAME: gnoll_camp_huts_basic
TAGS:   serial_gnoll_camp patrolling uniq_gnoll_camp_huts
NSUBST: . = 7:1 / 1:2 / 2:3 / 4:4 / *:.
MONS:   gnoll
MONS:   gnoll bouda
MONS:   gnoll sergeant
MONS:   jackal / hound / wolf w:1
MAP
     ........
    ....cc....
    ...xxxx...
    ..cx..xc..
 .....cx..xc.....
.......x++x.......
...cc........cc...
..xxxx......xxxx..
.cx..+......+..xc.
.cx..+......+..xc.
..xxxx......xxxx..
...cc........cc...
.......x++x.......
 .....cx%%xc.....
    ..cx%%xc..
    ...xxxx...
    ....cc....
     ........
ENDMAP
