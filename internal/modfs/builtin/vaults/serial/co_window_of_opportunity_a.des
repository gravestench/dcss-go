# co_window_of_opportunity_a is a small window piece.
# A gap through glass connects otherwise split floor areas. This changes how the floor connects.
# Its tag and WEIGHT let the controller select it without a file list.
NAME:   co_window_of_opportunity_a
WEIGHT: 3
TAGS:   transparent allow_dup extra serial_co_window_small
NSUBST: A = 1:@ / *:x
NSUBST: B = 1:@ / *:x
SUBST:  X:xm
MAP
@...@
xXmXx
x...x
x.x.x
x.x.x
A.x.B
xAxBx
  x
ENDMAP
