# Small symmetric camp shuffles its two leader slots around ordinary gnolls.
# Source default-depth is reset here: the controller selects this map by tag only.
NAME: gnoll_camp_mini_basic
TAGS:    serial_gnoll_camp patrolling allow_dup
SHUFFLE: 34
MONS:    gnoll, jackal / hound / wolf w:1
MONS:    gnoll bouda
MONS:    gnoll sergeant
MAP
.............
...cccccc....
..xxxxxxxx...
.cx......x.2.
.cx....1.x...
.cx.3........
.cx....1.x...
.cx......x.2.
..xxxxxxxx...
...cccccc....
.............
ENDMAP
