# Water-ring graveyard variant; smoke remains at the two outer edges.
# Source helper tags and weight are declared here so catalog selection sees them before the Lua hook runs.
NAME: serial_undead_f
TAGS: serial_undead extra allow_dup
WEIGHT: 2
SUBST:  . = .......--__tt
SUBST:  w = .wwW
: vault.run("configure")
MAP
..S...
.wwww.
wWWWww
.wWWW.
.wwww.
....S.
ENDMAP
