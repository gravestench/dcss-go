# Hut is one authored shape in the ruined-city serial.
# Its MAP geometry stays in DES; shared Lua hooks supply pillar and portal policy.
NAME: column_ruins_hut
TAGS:    serial_column_ruins_fancy
TAGS:    allow_dup transparent
WEIGHT:  40
SUBST:   0 = 0:40 9:10 $:15 %:5 *:1 T:9 _:120
SUBST:   T = TTUVVV
: vault.run("column_ruins_setup.hut")
: vault.run("column_ruins_setup.configure")
MAP
..NNMNN..
.MLKKKLM.
NLxxxxxLN
NKx___xKN
MJx_0_xJM
MKx___xKM
NLxx+xxLN
NLKJ_JKLN
.NMLLLMN.
...NNN...
ENDMAP
