# co_window_unsneaky_path_b is a common window piece.
# An exposed straight passage runs beside glass barriers. This changes how the floor connects.
# Its tag and WEIGHT let the controller select it without a file list.
NAME:   co_window_unsneaky_path_b
WEIGHT: 1
TAGS:   transparent allow_dup extra serial_co_window_common
MAP
xxxxxxx@xxxxxxx
xxxxxxx.xxxxxxx
xxxxxxx.xxxxxxx
xxxxxxx.xxxxxxx
@.....m.m.....@
@.....m.m.....@
@.....m.m.....@
xxxxxxx.xxxxxxx
xxxxxxx.xxxxxxx
xxxxxxx.xxxxxxx
xxxxxxx@xxxxxxx
ENDMAP
