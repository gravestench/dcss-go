# tomb_1 is a source-authored tomb_1 map. Its MAP is unchanged; named Lua hooks replace source script lines at their original positions.
NAME:     tomb_1
PLACE:    Tomb:1
ORIENT:   encompass
TAGS:     no_dump
SUBVAULT: A : tomb_1_centre
SUBVAULT: B : tomb_1_hall_stairs
: vault.run("shared.guardian_optional")
MONS:     royal mummy / nothing
MONS:     sphinx / nothing
MONS:     obsidian statue / orange crystal statue
NSUBST:   ( = 1:( / *:.
# Set up decorative statues.
: vault.run("shared.choose_statues")
SUBST:    FIJKLMNOPQ = G
# Add greater mummies and traps to the long hall. About 16 greater mummies and
# 6 traps on-average.
SUBST:    ' = 2:24 ^ .:210
KFEAT:    ^ = alarm trap / net trap / zot trap / dispersal trap
COLOUR:   FIJKLMNOPQ = yellow
TILE:     FIJKL = dngn_sarcophagus_pedestal_left
TILE:     MNOPQ = dngn_sarcophagus_pedestal_right
: vault.run("shared.sarcophagus")
: vault.run("shared.hatch_down_name")
MAP
