# Pinned DCSS source: crawl-ref/source/dat/des/branches/geh.des; geh_hangedman
NAME:    geh_hangedman
PLACE:  Geh:$
ORIENT:  encompass
MONS:    patrolling Asmodeus, brimstone fiend, balrug
MONS:    hellion, fire giant, salamander tyrant, hell hog
KMONS:   y = creeping inferno / fire vortex w:30
KMONS:   Y = molten gargoyle
KMONS:   zZ = searing wretch / hellephant / stoker w:2
KITEM:   $ = $ no_pickup
KFEAT:   yYZ = lava
KFEAT:   L = endless_lava
# Swap trios of hell knights with fire giants.
SHUFFLE: 5A6B / 5A6B / 6B5A
SUBST:   A = ., B = 6
# Just some pillar, door, and floor/wall/lava edge randomization.
SHUFFLE: O1 / |0, =- / =- / -=, !? / !? / ?!
SHUFFLE: ef, hi, def / def / edf / fed, ghi / ghi / hgi / ihg
SHUFFLE: EF / EF / FE, GH / GH / HG, IJ / IJ / JI
SHUFFLE: PQ / PQ / QP, RS / RS / SR, TU / TU / UT
SUBST:   X : ^<>, ^ = xxx., < = xx., > = x.
SUBST:   ` : `'", ` = ll., ' = l., " = l..
SUBST:   =! = +, -? = ., dg = v, efhi = .
SUBST:   EGIPRT = x, FHJQSU = l
KMASK:   l = no_monster_gen
: vault.run("serpent")
# Source Lua: serpent_of_hell_setup(_G)
: vault.run("border_fill")
# Source Lua: set_border_fill_type("endless_lava")
: vault.run("setup")
# Source Lua: geh_setup(_G); PLACE is static above.
